# Azure AI Foundry Project - use EITHER endpoint OR connection string
# Endpoint-based auth (recommended, uses DefaultAzureCredential - run `az login` first)
AZURE_AI_PROJECT_ENDPOINT=your-endpoint-here

# OR connection string auth (alternative)
# AZURE_AI_PROJECT_CONNECTION_STRING=your-connection-string-here

# Agent Names (as created in Foundry)
CONTEXT_BUILDER_AGENT_NAME=oceo-context-builder
CUSTOMER_DATA_AGENT_NAME=oceo-customerdata
INSIGHTS_AGENT_NAME=oceo-insights
AZURE_OPENAI_RESPONSES_API_VERSION="2025-04-01-preview"
